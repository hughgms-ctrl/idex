# Front (Vite) — copie para .env.local e preencha.
# Local: rode `pnpm db:start` e use a "API URL" e a "anon key" que ele mostra.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=cole-aqui-a-anon-key

# NUNCA coloque estas no front nem no repositório. Elas vão só nos secrets
# das Edge Functions (supabase secrets set ...):
# SUPABASE_SERVICE_ROLE_KEY=
# QR_SECRET=
